{
  "name": "@vizzele/core",
  "version": "0.10.0",
  "description": "Zero-dependency physics, gesture and motion engine behind Vizzele UI — springs, inertia, drag, magnetic, tilt, spotlight and more.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/auto.js",
    "./dist/auto.cjs",
    "./dist/vizzele.global.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/vizzele.global.js",
  "jsdelivr": "./dist/vizzele.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./gl": {
      "import": {
        "types": "./dist/gl.d.ts",
        "default": "./dist/gl.js"
      },
      "require": {
        "types": "./dist/gl.d.cts",
        "default": "./dist/gl.cjs"
      }
    },
    "./auto": {
      "import": {
        "types": "./dist/auto.d.ts",
        "default": "./dist/auto.js"
      },
      "require": {
        "types": "./dist/auto.d.cts",
        "default": "./dist/auto.cjs"
      }
    },
    "./global": "./dist/vizzele.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "animation",
    "spring",
    "physics",
    "drag",
    "gesture",
    "motion",
    "magnetic",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Gxnza48/vizzele-ui",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Gxnza48/vizzele-ui",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/check-global.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "size": "size-limit"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.3.0",
    "jsdom": "^30.1.3",
    "size-limit": "^14.3.0",
    "tsup": "^9.0.0",
    "vitest": "^5.0.5"
  }
}
